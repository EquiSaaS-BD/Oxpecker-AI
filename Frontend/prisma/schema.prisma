// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  type             String   @default("hospital") // hospital, clinic, chamber
  address          String?
  phone            String?
  licenseTier      String   @default("hospital_pro") // clinic_starter, hospital_pro, enterprise_gov
  licenseKey       String?  @unique
  dghsFacilityCode String?
  webhookUrl       String?
  webhookSecret    String?
  syncStatus       String   @default("active")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String?
  role           String   @default("patient") // patient, doctor, hospital, assistant, admin
  status         String   @default("active") // active, pending, banned
  phone          String?
  organizationId String   @default("org-default")
  bmdcRegNo      String?
  bmdcStatus     String   @default("none") // none, pending, verified
  specialty      String?
  hospitalName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, role])
  @@index([bmdcStatus])
}

model HealthPassCard {
  id               String   @id @default(uuid())
  cardNumber       String   @unique
  patientId        String
  organizationId   String   @default("org-default")
  fullName         String
  nidNumber        String?
  phone            String?
  bloodGroup       String?
  dateOfBirth      String?
  gender           String?
  allergies        Json?
  chronicDiseases  Json?
  medications      Json?
  emergencyContact String?
  qrSignature      String?
  isActivated      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([patientId])
  @@index([nidNumber])
  @@index([phone])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String
  actorName      String?
  actorRole      String?
  organizationId String   @default("org-default")
  action         String   // EMERGENCY_LOOKUP, QR_SCAN, PRESCRIPTION_ACCESS, BMDC_VERIFY
  targetType     String   // HealthPassCard, Patient, Prescription, MedicalDocument
  targetId       String
  reason         String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model AutomationEvent {
  id             String   @id @default(uuid())
  organizationId String   @default("org-default")
  type           String
  title          String
  patientName    String
  patientPhone   String?
  doctorName     String?
  channel        String
  status         String   @default("Delivered")
  summary        String   @db.Text
  smsPreview     String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([type])
}

model HmsBooking {
  id             String   @id @default(uuid())
  organizationId String   @default("org-default")
  patientName    String
  patientPhone   String?
  patientAge     Int?
  patientGender  String?
  doctorName     String?
  department     String?
  bookingStatus  String   @default("Confirmed")
  paymentStatus  String   @default("Unpaid")
  paidAmount     Float    @default(0)
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([bookingStatus])
}

model HmsAdmission {
  id             String   @id @default(uuid())
  organizationId String   @default("org-default")
  patientName    String
  smartCardUid   String?
  ward           String?
  bedNumber      String?
  status         String   @default("Admitted")
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model HmsBill {
  id             String   @id @default(uuid())
  organizationId String   @default("org-default")
  patientName    String
  totalAmount    Float    @default(0)
  paidAmount     Float    @default(0)
  status         String   @default("Running")
  payload        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
}

model Patient {
  id                String         @id @default(uuid())
  mrn               String         @unique // e.g. R 36 53 02
  organizationId    String         @default("org-default")
  name              String
  age               Int?
  gender            String?
  phone             String?
  email             String?
  nidNumber         String?
  bloodGroup        String?
  dateOfBirth       String?
  photoUrl          String?        @db.Text
  heightCm          Float?
  weightKg          Float?
  bmi               Float?
  allergies         Json?
  chronicConditions Json?
  vitalsSnapshot    Json?
  externalIds       Json?
  prescriptions     Prescription[]
  labReports        LabReport[]
  appointments      Appointment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId, updatedAt])
  @@index([phone])
  @@index([email])
  @@index([nidNumber])
  @@index([name])
}

model Prescription {
  id                 String   @id @default(uuid())
  patientId          String
  organizationId     String   @default("org-default")
  doctorId           String?
  doctorName         String?
  hospitalName       String?
  externalRefId      String?
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  chiefComplaint     String?  @db.Text
  physicalExam       String?  @db.Text
  vitals             Json?
  diagnosis          String?  @db.Text
  investigations     String?  @db.Text
  investigationsList Json?
  medicines          Json?
  advice             String?  @db.Text
  followUp           String?
  theme              String?  @default("modern")
  savingsBdt         Float    @default(0)
  ddiAlertsCount     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([organizationId, createdAt])
}

model LabReport {
  id             String   @id @default(uuid())
  patientId      String
  organizationId String   @default("org-default")
  facilityName   String?
  doctorName     String?
  findings       Json?
  reportDate     String?
  externalRefId  String?
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name           String
  type           String
  date           DateTime
  status         String   @default("Pending")
  pages          Int      @default(1)
  fileUrl        String?
  createdAt      DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([organizationId, createdAt])
}

model MedicalDocument {
  id              String   @id @default(uuid())
  ownerId         String   @db.VarChar(191)
  organizationId  String   @default("org-default") @db.VarChar(191)
  kind            String   @db.VarChar(32)
  originalName    String   @db.VarChar(255)
  mimeType        String   @db.VarChar(64)
  provider        String   @db.VarChar(128)
  category        String?  @db.VarChar(32)
  analysis        String   @db.Text
  priceComparison String?  @db.Text
  priceSnapshot   String?  @db.VarChar(512)
  image           Bytes
  consentAt       DateTime
  createdAt       DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([organizationId, createdAt])
}

// ============================================
// Oxpecker AI — Medical AI Assistant Models
// ============================================

model AiProvider {
  id         String    @id @default(uuid())
  name       String // "openai", "google", "anthropic", "deepseek"
  model      String // "gpt-4o-mini", "gemini-2.0-flash", etc.
  apiKey     String    @db.Text // Encrypted at application layer
  priority   Int       @default(0)
  isEnabled  Boolean   @default(true)
  isDefault  Boolean   @default(false)
  rateLimit  Int?
  usageCount Int       @default(0)
  totalCost  Float     @default(0)
  lastUsed   DateTime?
  healthOk   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ChatThread {
  id        String        @id @default(uuid())
  userId    String?
  title     String?
  mode      String? // "symptom_checker", "medicine", "nutrition", etc.
  language  String        @default("en")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // "user", "assistant", "system"
  content   String     @db.Text
  metadata  Json? // tool calls, sources, structured cards
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// ============================================
// Phase 2 — Doctor, Hospital, Medicine Search
// ============================================

model Doctor {
  id              String        @id @default(uuid())
  organizationId  String        @default("org-default")
  name            String
  degree          String
  speciality      String
  experience      Int // years
  hospital        String
  consultationFee Float
  languages       Json // ["Bangla", "English"]
  availableSlots  Json? // structured availability
  location        String
  lat             Float?
  lng             Float?
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  photoUrl        String?
  videoConsult    Boolean       @default(false)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([speciality])
  @@index([organizationId])
}

model Hospital {
  id              String   @id @default(uuid())
  organizationId  String   @default("org-default")
  name            String
  address         String
  specialities    Json // ["Cardiology", "Gynecology", ...]
  hasEmergency    Boolean  @default(false)
  hasICU          Boolean  @default(false)
  hasNICU         Boolean  @default(false)
  bedAvailability Int?
  consultationFee Float?
  lat             Float?
  lng             Float?
  rating          Float    @default(0)
  website         String?
  phone           String?
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([organizationId])
}

model DiagnosticCentre {
  id             String   @id @default(uuid())
  name           String
  address        String
  packages       Json // [{name, price, discount}]
  homeCollection Boolean  @default(false)
  lat            Float?
  lng            Float?
  rating         Float    @default(0)
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Medicine {
  id           String   @id @default(uuid())
  brandName    String
  genericName  String
  manufacturer String
  strength     String
  price        Float
  availability Boolean  @default(true)
  category     String?
  dosageForm   String? // tablet, syrup, injection
  warnings     Json? // ["pregnancy", "kidney"]
  alternatives Json? // [{brandName, price, manufacturer}]
  createdAt    DateTime @default(now())

  @@index([brandName])
  @@index([genericName])
}

model Appointment {
  id                String   @id @default(uuid())
  organizationId    String   @default("org-default")
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalName      String?
  specialty         String?
  source            String   @default("oxpecker") // oxpecker, clinic_website, widget, hms_walkin, csv_import
  externalBookingId String?
  dateTime          DateTime
  type              String // "in_person", "video"
  status            String   @default("pending") // pending, confirmed, cancelled, completed
  paymentStatus     String   @default("unpaid")
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([organizationId, dateTime])
  @@index([patientId, dateTime])
  @@index([doctorId, dateTime])
}

model TenantApiKey {
  id             String    @id @default(uuid())
  organizationId String    @default("org-default")
  label          String
  keyPrefix      String
  keyHash        String    @unique
  scopes         Json
  lastUsedAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([keyHash])
}

model IntegrationSyncLog {
  id               String   @id @default(uuid())
  organizationId   String   @default("org-default")
  direction        String   @default("inbound")
  channel          String   @default("rest_api")
  entityType       String
  externalRefId    String?
  idempotencyKey   String?  @unique
  status           String   @default("success")
  recordsProcessed Int      @default(1)
  errorMessage     String?  @db.Text
  payload          Json?
  createdAt        DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([channel])
}
