# Azure Database for PostgreSQL Flexible Server connection for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a stable 32-byte key and keep it in the deployment secret manager.
# The same key is required to decrypt previously stored medical documents.
MEDICAL_DOCUMENT_ENCRYPTION_KEY=

# Primary prescription OCR/vision provider (use a vision-capable deployment).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional OCR-only fallback. Leave blank unless the Azure Vision resource is configured.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
